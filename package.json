{
  "name": "pi-herdr-agents-lean",
  "version": "0.1.0",
  "description": "Token-lean wrapper around pi-herdr-agents: identical features, trimmed tool descriptions and schemas. Upstream is a pinned dependency, wrapped via Proxy.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./node_modules/pi-herdr-agents/skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "inventory": "tsx scripts/inventory.ts",
    "measure": "tsx scripts/measure.ts"
  },
  "dependencies": {
    "pi-herdr-agents": "3.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "js-tiktoken": "^1.0.20",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
